---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import Footer from '../../components/Footer.astro';
import { COURSE_URL } from '../../data/site';
import { getPosts, postUrl, formatDate } from '../../data/resources';

const posts = await getPosts();
const featured = posts[0];
const filters = [
  { value: 'all', label: 'All' },
  { value: 'Article', label: 'Articles' },
  { value: 'Newsletter', label: 'Newsletters' },
  { value: 'Video', label: 'Videos' },
];
---

<Base
  title="Free Legal Resources for Content Creators — For Creators, By Creators"
  description="Get free resources and guidance for online content creators by the team at For Creators, by Creators."
>
  <div class="hero">
    <SiteHeader />
    <div class="container hero-copy">
      <h1>Insights</h1>
      <p>Our thoughts on the creator economy, law, and other free insights for you</p>
    </div>
  </div>

  <main id="main">
    <section class="container featured" aria-label="Latest post">
      <a href={postUrl(featured)}>
        <Image src={featured.data.cover} alt="" widths={[600, 1200]} sizes="(max-width: 760px) 100vw, 580px" class="cover" loading="eager" />
        <div class="featured-copy">
          <span class="meta">
            <span class="tag">Latest</span>
            <time datetime={featured.data.date.toISOString().slice(0, 10)}>{formatDate(featured.data.date)}</time>
            <span>{featured.data.category}</span>
          </span>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.excerpt}</p>
          <span class="more">Read More →</span>
        </div>
      </a>
    </section>

    <section class="container" aria-labelledby="course-title">
      <div class="course">
        <div class="course-head">
          <h2 id="course-title"><span>Free:</span> Brand Deal Course</h2>
          <a class="btn" href={COURSE_URL}>Protect Yourself</a>
        </div>
        <div class="course-copy">
          <p>This course is for content creators who want to better learn about their rights and protect themselves in the market.</p>
          <p>
            The rights negotiated in brand deals are worth thousands of dollars. If you don’t know what these terms mean as a creator, it’s easy to sign onto a deal that gives away your rights to a brand.
          </p>
          <p>Educate yourself on the ins &amp; outs of typical brand deals so you know what you’re signing onto as a creator!</p>
        </div>
      </div>
    </section>

    <section class="container all" aria-labelledby="all-title" data-posts>
      <div class="all-head">
        <h2 id="all-title">All insights</h2>
        <div class="filters" role="group" aria-label="Filter posts">
          {
            filters.map((f, i) => (
              <button type="button" data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
      <ul class="grid">
        {
          posts.map((p, i) => (
            <li data-cat={p.data.category} data-featured={i === 0 ? '' : undefined} hidden={i === 0}>
              <PostCard post={p} />
            </li>
          ))
        }
      </ul>
      <p class="count visually-hidden" role="status" aria-live="polite" data-count></p>
      <div class="older">
        <button type="button" data-older hidden>Older Posts</button>
      </div>
    </section>

    <NewsletterBand formId="nl-resources" />
  </main>

  <Footer />
</Base>

<style>
  .hero {
    background: var(--navy);
    color: var(--cream);
  }
  .hero-copy {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 32px clamp(40px, 6vw, 96px);
    align-items: end;
  }
  h1 {
    font-weight: 700;
    font-size: clamp(72px, 10vw, 164px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .hero-copy p {
    margin: 0;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.4;
    font-weight: 500;
    color: var(--mist-2);
  }

  .featured {
    padding-top: clamp(56px, 7vw, 96px);
  }
  .featured a {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 32px clamp(40px, 5vw, 80px);
    align-items: center;
    text-decoration: none;
    color: var(--navy);
  }
  .featured :global(.cover) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--tile-bg);
  }
  .featured-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-size: 15px;
    font-weight: 500;
    color: var(--slate);
  }
  .tag {
    background: var(--navy);
    color: var(--cream);
    padding: 4px 10px;
    font-weight: 600;
    font-size: 13px;
  }
  .featured h2 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(34px, 3.6vw, 54px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    transition: color 0.2s;
  }
  .featured a:hover h2 {
    color: var(--peri-deep);
  }
  .featured-copy p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body-ink);
  }
  .more {
    font-weight: 600;
    font-size: 17px;
  }

  .course {
    margin-top: clamp(56px, 7vw, 96px);
    background: var(--sand);
    padding: clamp(32px, 4vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 32px clamp(40px, 5vw, 80px);
    align-items: start;
  }
  .course-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .course h2 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(40px, 4.6vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .course h2 span {
    color: var(--peri-deep);
  }
  .course .btn {
    background: var(--navy);
    color: var(--cream);
    padding: 18px 28px;
    font-size: 17px;
  }
  .course .btn:hover {
    background: var(--peri-deep);
    color: var(--cream);
  }
  .course-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .course-copy p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body-ink);
  }

  .all {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }
  .all-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--navy);
    padding-bottom: 20px;
    margin-bottom: 40px;
  }
  .all h2 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(36px, 4vw, 60px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filters button,
  .older button {
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--navy);
    background: transparent;
    color: var(--navy);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .filters button {
    font-size: 15px;
    padding: 10px 16px;
  }
  .filters button:hover {
    border-color: var(--peri-deep);
  }
  .filters button[aria-pressed='true'] {
    background: var(--navy);
    color: var(--cream);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 56px 32px;
  }
  .grid li[hidden] {
    display: none;
  }
  .older {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }
  .older button {
    font-size: 16px;
    padding: 16px 26px;
  }
  .older button:hover {
    background: var(--navy);
    color: var(--cream);
  }
  .older button[hidden] {
    display: none;
  }
  .older:has(button[hidden]) {
    margin-top: 0;
  }
</style>

<script>
  // Filters and "Older Posts". Without JavaScript every post simply shows.
  const PAGE = 18;

  document.querySelectorAll<HTMLElement>('[data-posts]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLLIElement>('li[data-cat]')];
    const older = root.querySelector<HTMLButtonElement>('[data-older]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    let filter = 'all';
    let limit = PAGE;

    const render = () => {
      // "All" leaves out the featured post (it's shown above); a category shows every match.
      const matches = items.filter((li) =>
        filter === 'all' ? !li.hasAttribute('data-featured') : li.dataset.cat === filter,
      );
      items.forEach((li) => (li.hidden = true));
      matches.slice(0, limit).forEach((li) => (li.hidden = false));
      older.hidden = matches.length <= limit;
      count.textContent = `Showing ${Math.min(limit, matches.length)} of ${matches.length} posts`;
    };

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        filter = btn.dataset.filter!;
        limit = PAGE;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        render();
      }),
    );

    older.addEventListener('click', () => {
      const firstNew = items.filter((li) => li.hidden && (filter === 'all' ? !li.hasAttribute('data-featured') : li.dataset.cat === filter))[0];
      limit += PAGE;
      render();
      firstNew?.querySelector('a')?.focus();
    });

    render();
  });
</script>
