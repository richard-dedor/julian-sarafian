---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { featuredStories, moreTestimonials, creatorVideoIds } from '../data/site';

// Until real videos are added, show four numbered placeholder tiles.
const videoSlots = creatorVideoIds.length ? creatorVideoIds : [null, null, null, null];
---

<Base
  title="Client Testimonials | For Creators By Creators"
  description="What creators and founders say about working with Julian Sarafian and For Creators By Creators: brand deals, defamation, stolen content, startups, and more."
>
  <div class="hero">
    <SiteHeader />
    <div class="container hero-copy">
      <h1>Client Testimonials</h1>
      <div class="hero-side">
        <p class="tagline">The word on the street.</p>
        <p class="note">Note: past outcomes do not guarantee future success. Every case is different.</p>
      </div>
    </div>
  </div>

  <main id="main">
    <section class="container stories" aria-label="Client stories">
      {
        featuredStories.map((f, i) => (
          <figure class:list={['story', { flip: i % 2 === 1 }]}>
            <Image src={f.photo} alt={f.name} width={420} height={525} widths={[420, 840]} sizes="(max-width: 760px) 100vw, 420px" class="photo" />
            <div class="story-copy">
              <blockquote>
                {f.quote.map((p, j) => (
                  <p class={j === 0 ? 'lead' : undefined}>{p}</p>
                ))}
              </blockquote>
              <figcaption>
                <span class="name">{f.name}</span>
                <span class="role">{f.role}</span>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </section>

    <section class="container more" aria-labelledby="more-title">
      <h2 id="more-title" class="h2">More from creators</h2>
      <div class="more-grid">
        {
          moreTestimonials.map((m) => (
            <figure>
              <blockquote>
                {m.quote.map((p) => (
                  <p>{p}</p>
                ))}
              </blockquote>
              <figcaption>
                <span class="name">{m.name}</span>
                <span class="handle">{m.handle}</span>
                <span class="role">{m.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="videos" aria-labelledby="videos-title">
      <div class="container">
        <h2 id="videos-title" class="h2">Hear directly from creators</h2>
        <div class="video-grid">
          {
            videoSlots.map((id, i) =>
              id ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${id}`}
                  title={`Creator video ${i + 1}`}
                  loading="lazy"
                  allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              ) : (
                <div class="video-placeholder">Creator video {i + 1}</div>
              ),
            )
          }
        </div>
      </div>
    </section>

    <FinalCta label="Get a Free Consult" formId="nl-testimonials" />
  </main>

  <Footer />
</Base>

<style>
  .hero {
    background: var(--navy);
    color: var(--cream);
  }
  .hero-copy {
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(56px, 6vw, 88px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px clamp(40px, 6vw, 96px);
    align-items: end;
  }
  h1 {
    font-weight: 700;
    font-size: clamp(48px, 9vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.05em;
    margin: 0;
  }
  .hero-side {
    flex: 1 1 320px;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tagline {
    margin: 0;
    font-size: clamp(28px, 2.8vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--peri);
  }
  .note {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--mist);
  }

  .stories {
    padding-top: clamp(48px, 6vw, 88px);
  }
  .story {
    margin: 0;
    padding: clamp(40px, 5vw, 72px) 0;
    border-bottom: 1px solid var(--rule-light);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 32px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .story :global(.photo) {
    width: 100%;
    max-width: 420px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    background: var(--tile-bg);
  }
  .story.flip :global(.photo) {
    order: 2;
  }
  .story-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .story blockquote p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body-ink);
    text-wrap: pretty;
  }
  .story blockquote p.lead {
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--navy);
  }
  .story figcaption {
    border-top: 2px solid var(--navy);
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .story .name {
    font-size: 20px;
    font-weight: 600;
  }
  .role {
    font-size: 15px;
    color: var(--slate);
  }

  .more {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }
  .more h2 {
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 0 clamp(40px, 5vw, 80px);
  }
  .more figure {
    margin: 0;
    padding: 32px 0;
    border-top: 2px solid var(--navy);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .more blockquote {
    gap: 14px;
  }
  .more blockquote p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--body-ink);
    text-wrap: pretty;
  }
  .more figcaption {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .more .name {
    font-size: 18px;
    font-weight: 600;
  }
  .handle {
    font-size: 15px;
    color: var(--peri-deep);
  }

  .videos {
    background: var(--navy);
    color: var(--cream);
    padding: var(--section-y) 0;
  }
  .videos h2 {
    margin-bottom: 40px;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .video-grid iframe,
  .video-placeholder {
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    display: block;
  }
  .video-placeholder {
    background: repeating-linear-gradient(135deg, #13284d 0 12px, #162d55 12px 24px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--peri);
    font-weight: 600;
    font-size: 15px;
  }

  @media (max-width: 760px) {
    .story.flip :global(.photo) {
      order: 0;
    }
  }
</style>
