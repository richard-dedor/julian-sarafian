---
// A Free Resources post preview: cover, date + category, title, optional excerpt.
import { Image } from 'astro:assets';
import { postUrl, formatDate, type Post } from '../data/resources';

interface Props {
  post: Post;
  excerpt?: boolean;
}
const { post, excerpt = true } = Astro.props;
const { title, date, category, cover } = post.data;
---

<a class="card" href={postUrl(post)}>
  <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 760px) 100vw, 400px" class="cover" />
  <span class="meta"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time><span class="cat">{category}</span></span>
  <h3>{title}</h3>
  {excerpt && post.data.excerpt && <p>{post.data.excerpt}</p>}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--navy);
  }
  .card :global(.cover) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--tile-bg);
  }
  .meta {
    display: flex;
    gap: 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--slate);
  }
  .cat {
    color: var(--peri-deep);
    font-weight: 600;
  }
  h3 {
    margin: 0;
    font-weight: 600;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: pretty;
    transition: color 0.2s;
  }
  .card:hover h3 {
    color: var(--peri-deep);
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
