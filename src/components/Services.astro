---
import { practiceAreas } from '../data/site';
---

<section id="services" aria-labelledby="services-title">
  <div class="container">
    <h2 id="services-title" class="lead">As a transactional law expert my practice areas include</h2>
    <ul>
      {
        practiceAreas.map((a) => (
          <li>
            <a href={a.href}>
              <span>{a.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  section {
    background: var(--navy);
    color: var(--cream);
    padding: clamp(64px, 8vw, 120px) 0;
    scroll-margin-top: 0;
  }
  .lead {
    margin: 0 0 32px;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--peri);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-dark);
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: clamp(10px, 1.2vw, 18px) 0;
    border-bottom: 1px solid var(--rule-dark);
    text-decoration: none;
    color: var(--cream);
    font-weight: 700;
    font-size: clamp(48px, 7.4vw, 124px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    transition: color 0.25s, padding-left 0.25s;
  }
  a:hover,
  a:focus-visible {
    color: var(--peri);
    padding-left: 24px;
  }
  .arrow {
    font-size: clamp(28px, 3vw, 48px);
    font-weight: 500;
    color: var(--peri-mid);
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: color 0.25s;
    }
  }
</style>
