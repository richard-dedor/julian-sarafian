---
import { NEWSLETTER_URL } from '../data/site';

interface Props {
  id: string; // unique per page, used for label/status ids
}
const { id } = Astro.props;
---

<form class="newsletter" data-newsletter data-endpoint={NEWSLETTER_URL} novalidate>
  <label class="visually-hidden" for={`${id}-email`}>Email address</label>
  <div class="field">
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="Email Address" required aria-describedby={`${id}-status`} />
    <button type="submit">Subscribe →</button>
  </div>
  <p id={`${id}-status`} class="status" role="status" aria-live="polite"></p>
</form>

<style>
  .field {
    display: flex;
    border-bottom: 2px solid var(--navy);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 14px 0;
    font-size: 18px;
    outline: none;
    color: var(--navy);
  }
  input::placeholder {
    color: var(--slate);
  }
  .field:focus-within {
    outline: 2px solid var(--peri-mid);
    outline-offset: 4px;
  }
  button {
    border: 0;
    background: transparent;
    font-weight: 700;
    cursor: pointer;
    color: var(--navy);
    font-size: 16px;
  }
  button:hover {
    color: var(--peri-deep);
  }
  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .status {
    margin: 10px 0 0;
    min-height: 1.5em;
    font-size: 15px;
    color: var(--slate);
  }
  .status.error {
    color: var(--navy);
    font-weight: 600;
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector('input')!;
    const button = form.querySelector('button')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const endpoint = form.dataset.endpoint;

    const show = (msg: string, isError = false) => {
      status.textContent = msg;
      status.classList.toggle('error', isError);
      input.setAttribute('aria-invalid', String(isError));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) return show('Please enter a valid email address.', true);
      if (!endpoint) return show('Newsletter signup is coming soon. Please check back shortly.', true);

      button.disabled = true;
      show('Subscribing…');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show('Thanks! You’re subscribed.');
      } catch {
        show('Something went wrong. Please try again.', true);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
