---
import { services, CONSULT_URL } from '../data/site';
---

<section class="container" aria-label="Practice areas">
  <div class="list" data-services>
    {
      services.map((s, i) => (
        <div class="item" id={s.id}>
          <h2>
            <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${s.id}-panel`} id={`${s.id}-q`}>
              <span>{s.name}</span>
              <span class="plus" aria-hidden="true">+</span>
            </button>
          </h2>
          <div class={`panel${i === 0 ? ' open' : ''}`} id={`${s.id}-panel`} role="region" aria-labelledby={`${s.id}-q`} inert={i !== 0}>
            <div class="clip">
              <div class="inner">
                <p>{s.body}</p>
                <a class="btn" href={CONSULT_URL}>Grab a free consult</a>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }
  .list {
    border-top: 2px solid var(--navy);
  }
  .item {
    border-bottom: 1px solid var(--rule-light);
    scroll-margin-top: 24px;
  }
  h2 {
    margin: 0;
    font: inherit;
  }
  button {
    width: 100%;
    text-align: left;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: clamp(16px, 1.8vw, 26px) 0;
    border: 0;
    background: transparent;
    color: var(--slate);
    font-weight: 700;
    font-size: clamp(36px, 5.4vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
    transition: color 0.2s;
  }
  button[aria-expanded='true'] {
    color: var(--navy);
  }
  button:hover {
    color: var(--peri-deep);
  }
  .plus {
    font-size: clamp(24px, 2.4vw, 40px);
    font-weight: 500;
    color: var(--peri-mid);
    transition: transform 0.3s;
  }
  button[aria-expanded='true'] .plus {
    transform: rotate(45deg);
  }
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }
  .panel.open {
    grid-template-rows: 1fr;
  }
  .clip {
    overflow: hidden;
  }
  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 20px 64px;
    padding: 0 0 clamp(28px, 3vw, 40px);
    align-items: start;
  }
  .inner p {
    margin: 0;
    font-size: 20px;
    line-height: 1.6;
    color: var(--body-ink);
    max-width: 620px;
  }
  .inner .btn {
    justify-self: end;
    background: var(--navy);
    color: var(--cream);
    padding: 14px 22px;
    font-size: 16px;
  }
  .inner .btn:hover {
    background: var(--peri-deep);
    color: var(--cream);
  }
  @media (max-width: 820px) {
    .inner .btn {
      justify-self: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel,
    .plus,
    button {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-services]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[aria-controls]')];
    const setOpen = (btn: HTMLButtonElement, open: boolean) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
      panel.inert = !open;
    };
    const openOnly = (btn?: HTMLButtonElement) => buttons.forEach((b) => setOpen(b, b === btn));

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const wasOpen = btn.getAttribute('aria-expanded') === 'true';
        openOnly(wasOpen ? undefined : btn);
      }),
    );

    // Opening /services#trademarking (etc.) expands that service.
    const openFromHash = () => {
      const item = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (item && root.contains(item)) openOnly(item.querySelector('button')!);
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  });
</script>
