---
import { Image } from 'astro:assets';
import julian from '../assets/julian.jpg';
import julian2 from '../assets/julian-2.jpg';
import SiteHeader from './SiteHeader.astro';
import { CONSULT_URL, HERO_VIDEO } from '../data/site';

const hasVideo = Boolean(HERO_VIDEO.mp4 || HERO_VIDEO.webm);
---

<section class="hero" data-hero>
  <div class="media" aria-hidden="true">
    {
      hasVideo ? (
        <video data-hero-video muted loop playsinline autoplay poster={HERO_VIDEO.poster || undefined}>
          {HERO_VIDEO.webm && <source src={HERO_VIDEO.webm} type="video/webm" />}
          {HERO_VIDEO.mp4 && <source src={HERO_VIDEO.mp4} type="video/mp4" />}
        </video>
      ) : (
        <>
          <Image src={julian2} alt="" widths={[960, 1600, 2200]} sizes="100vw" class="layer" loading="eager" />
          <Image src={julian} alt="" widths={[960, 1600, 2200]} sizes="100vw" class="layer fade" loading="eager" />
        </>
      )
    }
  </div>
  <div class="scrim"></div>

  <SiteHeader />

  <div class="copy">
    <h1>A law firm built for creators &amp; entrepreneurs</h1>
    <p>Our firm represents creators, social media influencers, small businesses, &amp; individuals.</p>
    <div class="ctas">
      <a class="btn consult" href={CONSULT_URL}>Grab a Free Consult</a>
      <a class="router-link" href="#router">Not sure what you need? ↓</a>
    </div>
  </div>

  <button class="toggle" type="button" data-hero-toggle aria-pressed="true" aria-label="Pause background video">
    <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="2" y="1" width="3.5" height="12" fill="currentColor"></rect><rect x="8.5" y="1" width="3.5" height="12" fill="currentColor"></rect></svg>
    <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1l10 6-10 6z" fill="currentColor"></path></svg>
  </button>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(880px, 100vh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--navy);
    color: var(--cream);
  }
  .media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .media video,
  .media :global(.layer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .media :global(.layer) {
    animation: ken 14s ease-in-out infinite alternate;
  }
  .media :global(.layer.fade) {
    animation: ken 14s ease-in-out infinite alternate, fade 16s ease-in-out infinite;
  }
  .hero.paused .media :global(.layer) {
    animation-play-state: paused;
  }
  @keyframes ken {
    from { transform: scale(1.02) translate(0, 0); }
    to { transform: scale(1.12) translate(-2%, -1%); }
  }
  @keyframes fade {
    0%, 42% { opacity: 1; }
    50%, 92% { opacity: 0; }
    100% { opacity: 1; }
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 30, 63, 0.92) 0%, rgba(10, 30, 63, 0.7) 45%, rgba(10, 30, 63, 0.15) 100%);
    pointer-events: none;
  }
  .copy {
    position: relative;
    margin-top: auto;
    padding: 64px var(--gutter) clamp(40px, 5vw, 72px);
    max-width: 820px;
  }
  h1 {
    font-weight: 600;
    font-size: clamp(48px, 5.8vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .copy p {
    font-size: 20px;
    line-height: 1.55;
    max-width: 520px;
    margin: 28px 0 36px;
    color: var(--mist-2);
  }
  .ctas {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    align-items: center;
  }
  .consult {
    background: var(--cream);
    color: var(--navy);
    padding: 18px 28px;
    font-size: 17px;
  }
  .consult:hover {
    background: var(--peri);
    color: var(--navy);
  }
  .router-link {
    font-weight: 600;
    font-size: 17px;
    color: var(--cream);
  }
  .router-link:hover {
    color: var(--peri);
  }
  .toggle {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(40px, 5vw, 72px);
    width: 44px;
    height: 44px;
    border: 1px solid var(--cream);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .toggle:hover {
    background: var(--cream);
    color: var(--navy);
  }
  .toggle .i-play,
  .hero.paused .toggle .i-pause {
    display: none;
  }
  .hero.paused .toggle .i-play {
    display: block;
  }
  @media (max-width: 640px) {
    .copy {
      padding-bottom: 84px;
    }
    .toggle {
      bottom: 20px;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const toggle = hero?.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const video = hero?.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (hero && toggle) {
    const setPlaying = (playing: boolean) => {
      hero.classList.toggle('paused', !playing);
      toggle.setAttribute('aria-pressed', String(playing));
      toggle.setAttribute('aria-label', playing ? 'Pause background video' : 'Play background video');
      if (video) playing ? video.play().catch(() => {}) : video.pause();
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) setPlaying(false);
    toggle.addEventListener('click', () => setPlaying(hero.classList.contains('paused')));
  }
</script>
