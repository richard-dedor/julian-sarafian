---
import { clients } from '../data/site';

// The list plus clones of the first 5 lets the track loop seamlessly.
const tiles = [...clients, ...clients.slice(0, 5)].map((c, i) => ({ ...c, clone: i >= clients.length }));
---

<section class="clients" aria-labelledby="clients-title" data-carousel data-count={clients.length}>
  <div class="container head">
    <h2 id="clients-title" class="h2">Hire the legal team behind some of your favorite creators</h2>
    <div class="arrows">
      <button type="button" data-prev aria-label="Previous clients">←</button>
      <button type="button" data-next aria-label="Next clients">→</button>
    </div>
  </div>
  <div class="viewport">
    <ul class="track" data-track>
      {
        tiles.map((c) => {
          const Tag = c.href ? 'a' : 'div';
          return (
            <li aria-hidden={c.clone ? 'true' : undefined}>
              <Tag class="tile" href={c.href} tabindex={c.clone && c.href ? -1 : undefined}>
                <div class="photo">
                  {c.photo && <img src={c.photo} alt={c.name} width="300" height="375" loading="lazy" />}
                  <span class="badge">{c.followers}</span>
                </div>
                <div class="meta">
                  <span class="name">{c.name}</span>
                  <span class="niche">{c.niche}</span>
                </div>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .clients {
    padding: var(--section-y) 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .head h2 {
    max-width: 820px;
  }
  .arrows {
    display: flex;
    gap: 8px;
  }
  .arrows button {
    width: 52px;
    height: 52px;
    border: 1px solid var(--navy);
    background: transparent;
    color: var(--navy);
    font-size: 20px;
    cursor: pointer;
  }
  .arrows button:hover {
    background: var(--navy);
    color: var(--cream);
  }
  .viewport {
    overflow: hidden;
    margin-top: 48px;
    padding-left: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .track.no-anim {
    transition: none;
  }
  li {
    flex: 0 0 300px;
  }
  .tile {
    text-decoration: none;
    color: var(--navy);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .photo {
    position: relative;
    width: 300px;
    height: 375px;
    background: var(--tile-bg);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--navy);
    color: var(--cream);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 10px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    border-top: 2px solid var(--navy);
    padding-top: 12px;
  }
  .name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .niche {
    font-size: 14px;
    color: var(--slate);
  }
</style>

<script>
  const STEP = 320; // tile width + gap
  const INTERVAL = 3000;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const n = Number(root.dataset.count);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let held = false; // hover or keyboard focus inside
    let resetTimer: number | undefined;

    const go = (i: number, animate = true) => {
      index = i;
      track.classList.toggle('no-anim', !animate);
      track.style.transform = `translateX(${-index * STEP}px)`;
    };

    const step = (d: number) => {
      if (index + d < 0) {
        // Jump to the clone at the end, then animate back one.
        go(n, false);
        requestAnimationFrame(() => requestAnimationFrame(() => go(n - 1)));
        return;
      }
      go(index + d);
      if (index >= n) {
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => go(0, false), 650);
      }
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    root.addEventListener('mouseenter', () => (held = true));
    root.addEventListener('mouseleave', () => (held = false));
    root.addEventListener('focusin', () => (held = true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) held = false;
    });

    if (!reduceMotion) {
      setInterval(() => {
        if (!held && !document.hidden) step(1);
      }, INTERVAL);
    }
  });
</script>
