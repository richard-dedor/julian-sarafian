---
import NewsletterForm from './NewsletterForm.astro';
import { CONSULT_URL } from '../data/site';
---

<section id="contact" class="container" aria-labelledby="cta-title">
  <h2 id="cta-title">I handle legal so you can build your business</h2>
  <div class="right">
    <a class="btn consult" href={CONSULT_URL}>Book my free consult</a>
    <p id="newsletter" class="blurb">
      Join the For Creators By Creators Creator Intel Newsletter for tips, insight, and guidance on how to grow, protect, and monetize your brand.
    </p>
    <NewsletterForm id="nl-home" />
  </div>
</section>

<style>
  section {
    padding-top: clamp(72px, 9vw, 128px);
    padding-bottom: clamp(72px, 9vw, 128px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 56px;
    align-items: end;
  }
  h2 {
    font-weight: 600;
    font-size: clamp(44px, 5.2vw, 80px);
    line-height: 0.98;
    margin: 0;
    letter-spacing: -0.04em;
  }
  .right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .consult {
    align-self: flex-start;
    background: var(--navy);
    color: var(--cream);
    padding: 20px 30px;
    font-size: 18px;
  }
  .consult:hover {
    background: var(--peri-deep);
    color: var(--cream);
  }
  .blurb {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--slate);
  }
</style>
