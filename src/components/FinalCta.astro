---
import { CONSULT_URL, NEWSLETTER_URL } from '../data/site';
---

<section id="contact" class="container" aria-labelledby="cta-title">
  <h2 id="cta-title">I handle legal so you can build your business</h2>
  <div class="right">
    <a class="btn consult" href={CONSULT_URL}>Book my free consult</a>
    <p id="newsletter" class="blurb">
      Join the For Creators By Creators Creator Intel Newsletter for tips, insight, and guidance on how to grow, protect, and monetize your brand.
    </p>
    <form data-newsletter data-endpoint={NEWSLETTER_URL} novalidate>
      <label class="visually-hidden" for="nl-email">Email address</label>
      <div class="field">
        <input id="nl-email" name="email" type="email" autocomplete="email" placeholder="Email Address" required aria-describedby="nl-status" />
        <button type="submit">Subscribe →</button>
      </div>
      <p id="nl-status" class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  section {
    padding-top: clamp(72px, 9vw, 128px);
    padding-bottom: clamp(72px, 9vw, 128px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 56px;
    align-items: end;
  }
  h2 {
    font-weight: 600;
    font-size: clamp(44px, 5.2vw, 80px);
    line-height: 0.98;
    margin: 0;
    letter-spacing: -0.04em;
  }
  .right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .consult {
    align-self: flex-start;
    background: var(--navy);
    color: var(--cream);
    padding: 20px 30px;
    font-size: 18px;
  }
  .consult:hover {
    background: var(--peri-deep);
    color: var(--cream);
  }
  .blurb {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--slate);
  }
  .field {
    display: flex;
    border-bottom: 2px solid var(--navy);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 14px 0;
    font-size: 18px;
    outline: none;
    color: var(--navy);
  }
  input::placeholder {
    color: var(--slate);
  }
  .field:focus-within {
    outline: 2px solid var(--peri-mid);
    outline-offset: 4px;
  }
  button {
    border: 0;
    background: transparent;
    font-weight: 700;
    cursor: pointer;
    color: var(--navy);
    font-size: 16px;
  }
  button:hover {
    color: var(--peri-deep);
  }
  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .status {
    margin: 10px 0 0;
    min-height: 1.5em;
    font-size: 15px;
    color: var(--slate);
  }
  .status.error {
    color: var(--navy);
    font-weight: 600;
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector('input')!;
    const button = form.querySelector('button')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const endpoint = form.dataset.endpoint;

    const show = (msg: string, isError = false) => {
      status.textContent = msg;
      status.classList.toggle('error', isError);
      input.setAttribute('aria-invalid', String(isError));
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) return show('Please enter a valid email address.', true);
      if (!endpoint) return show('Newsletter signup is coming soon. Please check back shortly.', true);

      button.disabled = true;
      show('Subscribing…');
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show('Thanks! You’re subscribed.');
      } catch {
        show('Something went wrong. Please try again.', true);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
